{
  "name": "LaysanX Atlas",
  "handle": "laysanx-atlas",
  "version": "2.0.0",
  "status": "draft",
  "author": "Laysan Technologies",
  "type": "standalone-html",
  "engine": "liquid-like",
  "frameworks": [
    "bootstrap-5",
    "gsap"
  ],
  "description": "Standalone HTML reference theme built from the internal TheLiaison source of truth.",
  "sourcePolicy": {
    "origin": "internal-the-liaison-source-of-truth",
    "copiedFrom": "LaysanX internal TheLiaison theme",
    "notes": "CSS and JavaScript foundation assets are taken directly from the internal .NET theme for exact UI/UX parity."
  },
  "assetRoot": "assets",
  "templateRoot": "templates",
  "sectionRoot": "sections",
